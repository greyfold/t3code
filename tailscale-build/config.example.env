# Copy to config.env (git-ignored) and adjust.

# 0: the nightly job only builds into release/<tag>/ and shows a notification.
# 1: it also installs into /Applications when T3 Code is not running
#    (the previous app goes to the Trash; retried on the next run otherwise).
AUTO_INSTALL=0

# Code-signing identity from your keychain, as listed by
#   security find-identity -v -p codesigning
# e.g. "Developer ID Application: Your Name (TEAMID)". Empty = unsigned build.
SIGN_IDENTITY=""

# Optional Apple notarization: name of a keychain profile created with
#   xcrun notarytool store-credentials
# Empty = no notarization (not needed for a build used on the Mac that built it).
NOTARY_PROFILE=""

# Optional display name for the built app (.app name, menu bar, Dock), e.g. "Privacy Code (Beta)".
# Empty = keep upstream's name. If you hand builds to other people, upstream's trademark
# policy (TRADEMARK.md) asks forks to use their own name and branding.
PRODUCT_NAME=""
